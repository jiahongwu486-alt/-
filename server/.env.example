# Waffo Pancake — environment template (copy to `.env` and fill real values)
# NEVER commit `.env`. NEVER put the private key in frontend code or Local Storage.

# Server-to-server credential
WAFFO_MERCHANT_ID=your_merchant_id_here
WAFFO_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# Webhook verification public key (Dashboard -> Settings -> Webhooks; test & prod differ)
WAFFO_WEBHOOK_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# Environment: test | prod
WAFFO_ENV=test

# Store & product (store from Dashboard; product via setup/create-product.mjs or Dashboard)
WAFFO_STORE_ID=your_store_id_here
WAFFO_PRODUCT_ID=your_product_id_here

# Server
PORT=8787
ALLOWED_ORIGIN=*

# Fixed report price (server-enforced; do NOT accept amounts from the client)
REPORT_PRICE_AMOUNT=1.99
REPORT_PRICE_CURRENCY=USD

# Where the buyer returns after payment (must be absolute https in production)
WAFFO_SUCCESS_URL=http://localhost:8791/middle-east/index.html
